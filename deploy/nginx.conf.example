server {
    listen 443 ssl;
    # "http2 on;" needs nginx 1.25.1+. On older versions (e.g. 1.24 on
    # Ubuntu 24.04) drop it and use "listen 443 ssl http2;" instead.
    http2 on;
    server_name slownik.example.com;

    ssl_certificate     /etc/letsencrypt/live/slownik.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/slownik.example.com/privkey.pem;

    gzip on;
    gzip_types text/css application/javascript;

    location / {
        proxy_pass http://127.0.0.1:8080;
        # Host is needed by CSRF protection's Origin check.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The app tags its log lines with this ID, so they can be matched
        # with nginx's. Always set it: it overrides one sent by the client.
        # To have it in the access log too, add $request_id to a log_format
        # (http context), e.g.:
        #   log_format main '$remote_addr [$time_local] "$request" $status '
        #                   '$body_bytes_sent rid=$request_id';
        proxy_set_header X-Request-ID $request_id;
    }
}

server {
    listen 80;
    server_name slownik.example.com;
    return 301 https://$host$request_uri;
}
