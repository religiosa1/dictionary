# /etc/dictionary/env — chmod 600, it holds the client secret.
DICT_LISTEN_ADDR=127.0.0.1:8080
DICT_BASE_URL=https://slownik.example.com
DICT_OIDC_ISSUER=https://id.example.com
DICT_OIDC_CLIENT_ID=
DICT_OIDC_CLIENT_SECRET=
# Members of this PocketID group become editors, everyone else is a reader.
DICT_EDITOR_GROUP=dictionary-editors
# true: anonymous visitors can read; login is only needed for editing.
DICT_PUBLIC_READ=false
